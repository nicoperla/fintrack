# Stesso database di FinTrack (copia i valori dal progetto principale)
DATABASE_URL=""
DIRECT_URL=""

# Chiave del pannello: firma le sessioni e cifra la chiave del 2FA. Almeno 32 caratteri casuali:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Usa la stessa in locale e su Vercel. Cambiarla chiude le sessioni e obbliga a rifare il setup.
ADMIN_SECRET=""

# Codice da inserire nella pagina /setup per creare il primo amministratore.
# Dopo il setup cancellalo: la pagina /setup si chiude comunque da sola.
ADMIN_SETUP_TOKEN=""

# Opzionale: solo questi IP possono aprire il pannello (separati da virgola). Vuoto: tutti.
ADMIN_ALLOWED_IPS=""

# Opzionale: indirizzo di FinTrack, per i link nelle email (reset password).
FINTRACK_URL="https://fintrack-six-iota.vercel.app"

# Opzionali, gli stessi valori di FinTrack:
# Stripe, per abbonamenti, pagamenti e incassi
STRIPE_SECRET_KEY=""
# Resend, per le email agli utenti (reset password, avvisi)
RESEND_API_KEY=""
EMAIL_FROM=""
