generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  CHECKING
  CASH
  CARD
  SAVINGS
  INVESTMENT
}

// Categories only use INCOME/EXPENSE; TRANSFER moves money between two of the user's accounts
// and is excluded from income/expense totals.
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum HouseholdRole {
  OWNER
  MEMBER
}

/// FREE: everything but the AI coach chat; PRO: paid subscription (Stripe).
enum Plan {
  FREE
  PRO
}

/// How shared expenses are divided among the members of a space ("Conti chiari").
enum SplitMode {
  EQUAL
  INCOME
}

/// What a "Riprenditeli" claim asks for (lib/finance/claims.ts).
enum ClaimKind {
  /// Cancel a subscription; afterwards FinTrack watches for charges past the effective date.
  CANCELLATION
  /// Refund of a SEPA direct debit, within 8 weeks of the charge (artt. 13-14 d.lgs. 11/2010).
  DIRECT_DEBIT_REFUND
  /// Complaint to the bank (fees, a charge it shouldn't have taken); then the Arbitro Bancario Finanziario.
  BANK_COMPLAINT
  /// A merchant charged twice or the wrong amount: ask the merchant first.
  DUPLICATE_CHARGE
}

/// DRAFT → SENT → WON / PARTIAL / LOST, or DROPPED when the user gives up.
enum ClaimStatus {
  DRAFT
  SENT
  WON
  PARTIAL
  LOST
  DROPPED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String?
  /// Weekly summary email (Monday morning); can be turned off from settings or the email link.
  weeklyDigest       Boolean   @default(true) @map("weekly_digest")
  /// Net monthly income for "what this costs in working time"; null: estimated from recorded income.
  monthlyNetIncome   Decimal?  @map("monthly_net_income") @db.Decimal(14, 2)
  workHoursPerWeek   Int       @default(40) @map("work_hours_per_week")
  showWorkTime       Boolean   @default(true) @map("show_work_time")
  /// How the user wants to manage money: the coach's method, targets and priorities (lib/finance/coach-profile.ts).
  coachProfile       Json?     @map("coach_profile")
  /// The space currently shown; null (or a space the user left) falls back to their own.
  activeHouseholdId  String?   @map("active_household_id")
  /// Null until the user opens the link sent at sign-up.
  emailVerifiedAt    DateTime? @map("email_verified_at")
  /// When the user accepted the terms and the privacy policy (at sign-up).
  termsAcceptedAt    DateTime? @map("terms_accepted_at")
  /// Consent to send a summary of the data to the AI provider when asking the coach.
  aiConsentAt        DateTime? @map("ai_consent_at")
  plan               Plan      @default(FREE)
  stripeCustomerId   String?   @unique @map("stripe_customer_id")
  /// Stripe subscription status (active, past_due, canceled…), null if never subscribed.
  subscriptionStatus String?   @map("subscription_status")
  /// End of the paid period: renewal date, or the last day when the subscription was cancelled.
  planRenewsAt       DateTime? @map("plan_renews_at")
  planCancelsAtEnd   Boolean   @default(false) @map("plan_cancels_at_end")
  /// Dependent children, for the per-child limits of the 730 deductions (school, sport, nursery).
  dependentChildren  Int       @default(0) @map("dependent_children")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  activeHousehold     Household?               @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id], onDelete: SetNull)
  ownedHouseholds     Household[]              @relation("HouseholdOwner")
  memberships         HouseholdMember[]
  sentInvites         HouseholdInvite[]
  // Records this user created. Data belongs to the household: it survives if the author leaves.
  accounts            FinancialAccount[]
  categories          Category[]
  transactions        Transaction[]
  passwordResetTokens PasswordResetToken[]
  emailTokens         EmailVerificationToken[]
  budgets             Budget[]
  goals               Goal[]
  debts               Debt[]
  settlementsPaid     Settlement[]             @relation("SettlementFrom")
  settlementsReceived Settlement[]             @relation("SettlementTo")
  claims              Claim[]

  @@map("users")
}

// A space whose finances are shared by its members (a couple, a family). Every user gets a
// personal one at sign-up and can invite others into it; all financial data is scoped here.
model Household {
  id         String    @id @default(cuid())
  name       String
  /// Base currency: totals, budgets, goals and debts are expressed in it.
  currency   String    @default("EUR") @db.Char(3)
  /// Shared expenses: split equally or in proportion to each member's income.
  splitMode  SplitMode @default(EQUAL) @map("split_mode")
  /// Expenses are shared from this date (null: from the start of the current month).
  splitSince DateTime? @map("split_since") @db.Date
  ownerId    String    @map("owner_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  owner             User                  @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activeFor         User[]                @relation("ActiveHousehold")
  members           HouseholdMember[]
  invites           HouseholdInvite[]
  accounts          FinancialAccount[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  debts             Debt[]
  settlements       Settlement[]
  dismissedFindings FoundMoneyDismissal[]
  valuations        InvestmentValuation[]
  claims            Claim[]

  @@index([ownerId])
  @@map("households")
}

model HouseholdMember {
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

// Invitations are links bound to an email address; only the SHA-256 of the token is stored.
model HouseholdInvite {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  email       String
  tokenHash   String   @unique @map("token_hash")
  invitedById String?  @map("invited_by_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("household_invites")
}

// Daily ECB reference rates (via Frankfurter): units of `currency` for 1 EUR.
model ExchangeRate {
  date     DateTime @db.Date
  currency String   @db.Char(3)
  rate     Decimal  @db.Decimal(18, 8)

  @@id([date, currency])
  @@map("exchange_rates")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Named FinancialAccount because NextAuth's Prisma adapter reserves the `Account` model (needed for OAuth).
// The current balance is derived (see lib/finance/balances.ts), never stored.
model FinancialAccount {
  id             String      @id @default(cuid())
  householdId    String      @map("household_id")
  /// Who created it (null if they deleted their account).
  userId         String?     @map("user_id")
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(14, 2)
  currency       String      @default("EUR") @db.Char(3)
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  household         Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions      Transaction[]         @relation("TransactionAccount")
  incomingTransfers Transaction[]         @relation("TransferDestination")
  valuations        InvestmentValuation[]

  @@index([householdId])
  @@map("accounts")
}

model Category {
  id          String          @id @default(cuid())
  householdId String          @map("household_id")
  /// Who created it (null if they deleted their account).
  userId      String?         @map("user_id")
  name        String
  type        TransactionType
  parentId    String?         @map("parent_id")
  icon        String?
  color       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  budget       Budget?

  @@index([householdId])
  @@index([parentId])
  @@map("categories")
}

// A recurring monthly spending limit. A budget on a parent category also counts its subcategories.
model Budget {
  id             String   @id @default(cuid())
  householdId    String   @map("household_id")
  /// Who created it (null if they deleted their account).
  userId         String?  @map("user_id")
  categoryId     String   @unique @map("category_id")
  amount         Decimal  @db.Decimal(14, 2)
  alertThreshold Int      @default(80) @map("alert_threshold")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(cuid())
  householdId   String    @map("household_id")
  /// Who created it (null if they deleted their account).
  userId        String?   @map("user_id")
  name          String
  targetAmount  Decimal   @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(14, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  icon          String?
  color         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("goals")
}

// userId is denormalized from the account so per-user queries and ownership checks need no join.
// For TRANSFER, accountId is the source, transferAccountId the destination, and categoryId is null.
model Transaction {
  id                String          @id @default(cuid())
  householdId       String          @map("household_id")
  /// Who created it (null if they deleted their account).
  userId            String?         @map("user_id")
  accountId         String          @map("account_id")
  transferAccountId String?         @map("transfer_account_id")
  categoryId        String?         @map("category_id")
  type              TransactionType
  /// In the account's currency.
  amount            Decimal         @db.Decimal(14, 2)
  /// `amount` converted to the household currency at the rate of `date`: all totals sum this.
  baseAmount        Decimal         @map("base_amount") @db.Decimal(14, 2)
  /// TRANSFER between currencies: what the destination account receives, in its currency.
  transferAmount    Decimal?        @map("transfer_amount") @db.Decimal(14, 2)
  date              DateTime        @db.Date
  description       String
  notes             String?
  tags              String[]        @default([])
  /// 730 deduction chosen by hand: a type (lib/finance/deductions.ts) or "none"; null = automatic.
  deduction         String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  household       Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  account         FinancialAccount  @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount FinancialAccount? @relation("TransferDestination", fields: [transferAccountId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  claims          Claim[]

  @@index([householdId, date])
  @@index([userId])
  @@index([accountId, date])
  @@index([transferAccountId])
  @@index([categoryId])
  @@map("transactions")
}

// A loan or revolving balance for the payoff planner (snowball / avalanche).
model Debt {
  id             String   @id @default(cuid())
  householdId    String   @map("household_id")
  /// Who created it (null if they deleted their account).
  userId         String?  @map("user_id")
  name           String
  balance        Decimal  @db.Decimal(14, 2)
  interestRate   Decimal  @map("interest_rate") @db.Decimal(5, 2)
  minimumPayment Decimal  @map("minimum_payment") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("debts")
}

// "Conti chiari": money one member gives another to even out the shared expenses.
model Settlement {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  fromUserId  String   @map("from_user_id")
  toUserId    String   @map("to_user_id")
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  from      User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([householdId, date])
  @@map("settlements")
}

// Sign-up confirmation links; only the SHA-256 of the token is stored.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Fixed-window counters for rate limiting (login, sign-up, password reset, coach…).
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@index([windowStart])
  @@map("rate_limits")
}

// "Soldi ritrovati": findings the user marked as fine (a duplicate that wasn't, a renewal they want).
model FoundMoneyDismissal {
  householdId String   @map("household_id")
  key         String
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([householdId, key])
  @@map("found_money_dismissals")
}

/// The market value of an investment account on a day, as the bank or broker shows it. The
/// account's transactions are the money put in and taken out; the gap is the gain or loss.
model InvestmentValuation {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  accountId   String   @map("account_id")
  date        DateTime @db.Date
  /// In the account's currency.
  value       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([householdId])
  @@map("investment_valuations")
}

/// "Riprenditeli": a request to get money back or stop paying, from draft to outcome. The user
/// sends the letter themselves; FinTrack keeps the deadlines (lib/finance/claims.ts).
model Claim {
  id              String      @id @default(cuid())
  householdId     String      @map("household_id")
  /// Who opened it and sends it in their own name (null if they deleted their account).
  userId          String?     @map("user_id")
  kind            ClaimKind
  status          ClaimStatus @default(DRAFT)
  /// The "Soldi ritrovati" finding it started from ("dup:<transaction>", "sub:<recurring key>",
  /// "fees", "after:<transaction>"): one claim per finding.
  findingKey      String?     @map("finding_key")
  /// The charge being contested, if any.
  transactionId   String?     @map("transaction_id")
  /// Who took the money: the merchant, the provider or the bank.
  counterparty    String
  /// Expected money back, or saved per year for a CANCELLATION; in the space's currency.
  expectedAmount  Decimal     @map("expected_amount") @db.Decimal(14, 2)
  /// What actually came back (or is saved per year), set when the claim is closed.
  recoveredAmount Decimal?    @map("recovered_amount") @db.Decimal(14, 2)
  /// The letter as the user sends it. Bank details stay placeholders and are never stored here.
  subject         String
  body            String
  /// email | pec | raccomandata | app | sportello (lib/finance/claims.ts CLAIM_CHANNELS).
  channel         String?
  sentAt          DateTime?   @map("sent_at") @db.Date
  /// CANCELLATION: the day from which the service must no longer be charged.
  effectiveFrom   DateTime?   @map("effective_from") @db.Date
  /// DRAFT: last day to act; SENT: last day for the other side to answer.
  deadline        DateTime?   @db.Date
  closedAt        DateTime?   @map("closed_at")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  // NULLs don't collide in Postgres: claims opened by hand have no finding and never conflict.
  @@unique([householdId, findingKey])
  @@index([householdId, status])
  @@index([transactionId])
  @@map("claims")
}
