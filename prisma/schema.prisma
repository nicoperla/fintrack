generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  CHECKING
  CASH
  CARD
  SAVINGS
  INVESTMENT
}

// Categories only use INCOME/EXPENSE; TRANSFER moves money between two of the user's accounts
// and is excluded from income/expense totals.
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String   @map("password_hash")
  name              String?
  /// Weekly summary email (Monday morning); can be turned off from settings or the email link.
  weeklyDigest      Boolean  @default(true) @map("weekly_digest")
  /// Net monthly income for "what this costs in working time"; null: estimated from recorded income.
  monthlyNetIncome  Decimal? @map("monthly_net_income") @db.Decimal(14, 2)
  workHoursPerWeek  Int      @default(40) @map("work_hours_per_week")
  showWorkTime      Boolean  @default(true) @map("show_work_time")
  /// The space currently shown; null (or a space the user left) falls back to their own.
  activeHouseholdId String?  @map("active_household_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  activeHousehold     Household?           @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id], onDelete: SetNull)
  ownedHouseholds     Household[]          @relation("HouseholdOwner")
  memberships         HouseholdMember[]
  sentInvites         HouseholdInvite[]
  // Records this user created. Data belongs to the household: it survives if the author leaves.
  accounts            FinancialAccount[]
  categories          Category[]
  transactions        Transaction[]
  passwordResetTokens PasswordResetToken[]
  budgets             Budget[]
  goals               Goal[]
  debts               Debt[]

  @@map("users")
}

// A space whose finances are shared by its members (a couple, a family). Every user gets a
// personal one at sign-up and can invite others into it; all financial data is scoped here.
model Household {
  id        String   @id @default(cuid())
  name      String
  /// Base currency: totals, budgets, goals and debts are expressed in it.
  currency  String   @default("EUR") @db.Char(3)
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User               @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activeFor    User[]             @relation("ActiveHousehold")
  members      HouseholdMember[]
  invites      HouseholdInvite[]
  accounts     FinancialAccount[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
  debts        Debt[]

  @@index([ownerId])
  @@map("households")
}

model HouseholdMember {
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

// Invitations are links bound to an email address; only the SHA-256 of the token is stored.
model HouseholdInvite {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  email       String
  tokenHash   String   @unique @map("token_hash")
  invitedById String?  @map("invited_by_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("household_invites")
}

// Daily ECB reference rates (via Frankfurter): units of `currency` for 1 EUR.
model ExchangeRate {
  date     DateTime @db.Date
  currency String   @db.Char(3)
  rate     Decimal  @db.Decimal(18, 8)

  @@id([date, currency])
  @@map("exchange_rates")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Named FinancialAccount because NextAuth's Prisma adapter reserves the `Account` model (needed for OAuth).
// The current balance is derived (see lib/finance/balances.ts), never stored.
model FinancialAccount {
  id             String      @id @default(cuid())
  householdId    String      @map("household_id")
  /// Who created it (null if they deleted their account).
  userId         String?     @map("user_id")
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(14, 2)
  currency       String      @default("EUR") @db.Char(3)
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  household         Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions      Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransferDestination")

  @@index([householdId])
  @@map("accounts")
}

model Category {
  id          String          @id @default(cuid())
  householdId String          @map("household_id")
  /// Who created it (null if they deleted their account).
  userId      String?         @map("user_id")
  name        String
  type        TransactionType
  parentId    String?         @map("parent_id")
  icon        String?
  color       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  budget       Budget?

  @@index([householdId])
  @@index([parentId])
  @@map("categories")
}

// A recurring monthly spending limit. A budget on a parent category also counts its subcategories.
model Budget {
  id             String   @id @default(cuid())
  householdId    String   @map("household_id")
  /// Who created it (null if they deleted their account).
  userId         String?  @map("user_id")
  categoryId     String   @unique @map("category_id")
  amount         Decimal  @db.Decimal(14, 2)
  alertThreshold Int      @default(80) @map("alert_threshold")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(cuid())
  householdId   String    @map("household_id")
  /// Who created it (null if they deleted their account).
  userId        String?   @map("user_id")
  name          String
  targetAmount  Decimal   @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(14, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  icon          String?
  color         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("goals")
}

// userId is denormalized from the account so per-user queries and ownership checks need no join.
// For TRANSFER, accountId is the source, transferAccountId the destination, and categoryId is null.
model Transaction {
  id                String          @id @default(cuid())
  householdId       String          @map("household_id")
  /// Who created it (null if they deleted their account).
  userId            String?         @map("user_id")
  accountId         String          @map("account_id")
  transferAccountId String?         @map("transfer_account_id")
  categoryId        String?         @map("category_id")
  type              TransactionType
  /// In the account's currency.
  amount            Decimal         @db.Decimal(14, 2)
  /// `amount` converted to the household currency at the rate of `date`: all totals sum this.
  baseAmount        Decimal         @map("base_amount") @db.Decimal(14, 2)
  /// TRANSFER between currencies: what the destination account receives, in its currency.
  transferAmount    Decimal?        @map("transfer_amount") @db.Decimal(14, 2)
  date              DateTime        @db.Date
  description       String
  notes             String?
  tags              String[]        @default([])
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  household       Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  account         FinancialAccount  @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount FinancialAccount? @relation("TransferDestination", fields: [transferAccountId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([householdId, date])
  @@index([userId])
  @@index([accountId, date])
  @@index([transferAccountId])
  @@index([categoryId])
  @@map("transactions")
}

// A loan or revolving balance for the payoff planner (snowball / avalanche).
model Debt {
  id             String   @id @default(cuid())
  householdId    String   @map("household_id")
  /// Who created it (null if they deleted their account).
  userId         String?  @map("user_id")
  name           String
  balance        Decimal  @db.Decimal(14, 2)
  interestRate   Decimal  @map("interest_rate") @db.Decimal(5, 2)
  minimumPayment Decimal  @map("minimum_payment") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("debts")
}
