generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  CHECKING
  CASH
  CARD
  SAVINGS
  INVESTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts            FinancialAccount[]
  categories          Category[]
  transactions        Transaction[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Named FinancialAccount because NextAuth's Prisma adapter reserves the `Account` model (needed for OAuth).
// The current balance is derived: initialBalance + income - expenses.
model FinancialAccount {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(14, 2)
  currency       String      @default("EUR") @db.Char(3)
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  name      String
  type      TransactionType
  parentId  String?         @map("parent_id")
  icon      String?
  color     String?
  createdAt DateTime        @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]

  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

// userId is denormalized from the account so per-user queries and ownership checks need no join.
model Transaction {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  accountId   String          @map("account_id")
  categoryId  String?         @map("category_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime        @db.Date
  description String
  notes       String?
  tags        String[]        @default([])
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId, date])
  @@index([categoryId])
  @@map("transactions")
}
