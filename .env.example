# Neon: connessione pooled (usata dall'app)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon: connessione diretta, stesso host senza "-pooler" (usata da prisma migrate)
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth — genera il secret con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Opzionale: invio email (reset password, riepilogo settimanale) via Resend. Senza, le email vengono stampate nei log del server.
RESEND_API_KEY=""
EMAIL_FROM="FinTrack <onboarding@resend.dev>"

# Riepilogo settimanale: segreto che Vercel Cron invia come "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Opzionale: coach AI (risponde a qualsiasi domanda sui tuoi soldi). Basta una delle due chiavi.
# Gratis, senza carta: chiave Groq da https://console.groq.com/keys
GROQ_API_KEY=""
# A pagamento, più capace: chiave Anthropic da https://console.anthropic.com (ha la precedenza su Groq)
# Senza, il coach funziona lo stesso con consigli e risposte rapide calcolati dall'app.
ANTHROPIC_API_KEY=""
# Modello del coach AI (predefinito: claude-opus-5-5 con Anthropic, openai/gpt-oss-120b con Groq)
COACH_MODEL=""
# Coach AI: domande per persona al giorno, e al minuto per tutta l'app (vuoto: 2 con Groq gratuito)
COACH_DAILY_LIMIT=""
COACH_GLOBAL_PER_MINUTE=""

# Pagamenti FinTrack Pro (Stripe). Senza queste tre variabili i pagamenti sono spenti.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Titolare mostrato in privacy e termini (obbligatorio prima di aprire al pubblico)
LEGAL_OWNER=""
LEGAL_EMAIL=""
